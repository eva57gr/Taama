# Copy to backend/.env. With a key set, images are OCR'd by OpenAI; without one, local RapidOCR is used.
# The claim verdict itself stays on the deterministic engine unless CLAIMCHECK_JUDGE is left on.
OPENAI_API_KEY=
# OPENAI_OCR_MODEL=gpt-4o
# CLAIMCHECK_OCR=openai   # or rapidocr, to force one engine
# CLAIMCHECK_JUDGE=off    # off keeps verdicts deterministic; omit (with a key set) to add the AI judge
# OPENAI_JUDGE_MODEL=gpt-4.1
# OPENAI_EMBED_MODEL=text-embedding-3-small
